<Window x:Class="FpsMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="FPS Monitor"
        Height="740" Width="960"
        MinHeight="640" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgPrimary}"
        Foreground="{StaticResource TextPrimary}">
 
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Верхняя панель конфигурации -->
        <Border Grid.Row="0"
                Background="{StaticResource BgSecondary}"
                BorderBrush="{StaticResource BorderBrushSubtle}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- PresentMon -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="95" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="PresentMon"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="13"
                               VerticalAlignment="Center" />

                    <TextBox x:Name="PresentMonPathBox"
                             Grid.Column="1"
                             Style="{StaticResource ModernTextBox}"
                             Margin="0,0,10,0" />

                    <Button Grid.Column="2"
                            Content="Обзор…"
                            Style="{StaticResource ModernButton}"
                            Click="BrowsePresentMon_Click" />
                </Grid>

                <!-- Игра и кнопки управления -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="95" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Игра"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="13"
                               VerticalAlignment="Center" />

                    <Border Grid.Column="1"
                            Background="{StaticResource BgPrimary}"
                            BorderBrush="{StaticResource BorderBrushSubtle}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,6"
                            Margin="0,0,10,0">
                        <TextBlock x:Name="SelectedGameText"
                                   Text="Не выбрана"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="13"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="Выбрать игру…"
                                Style="{StaticResource ModernButton}"
                                Click="SelectGame_Click"
                                Margin="0,0,8,0" />

                        <Button x:Name="StartStopButton"
                                Content="Старт"
                                Style="{StaticResource PrimaryButton}"
                                MinWidth="92"
                                Click="StartStop_Click"
                                Margin="0,0,8,0" />

                        <ToggleButton x:Name="OverlayToggle"
                                      Content="Оверлей"
                                      Style="{StaticResource ModernToggle}"
                                      Checked="OverlayToggle_Changed"
                                      Unchecked="OverlayToggle_Changed"
                                      Margin="0,0,8,0" />

                        <Button Content="Сброс"
                                ToolTip="Сбросить Avg / Min / Max / 1% Low и график"
                                Style="{StaticResource ModernButton}"
                                Click="ResetStats_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Карточки метрик -->
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,14,0,14">
            <!-- FPS -->
            <Border Background="{StaticResource BgCard}"
                    BorderBrush="{StaticResource BorderBrushSubtle}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14,12"
                    Margin="0,0,7,7">
                <StackPanel>
                    <TextBlock Text="ТЕКУЩИЙ FPS"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="11" FontWeight="SemiBold" />
                    <TextBlock x:Name="FpsValueText"
                               Text="—"
                               FontSize="28" FontWeight="Bold" FontFamily="Consolas"
                               Foreground="{StaticResource AccentGreen}"
                               Margin="0,4,0,2" />
                    <TextBlock x:Name="FrametimeSubText"
                               Text="Frametime: —"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="12" />
                </StackPanel>
            </Border>

            <!-- Сессия FPS -->
            <Border Background="{StaticResource BgCard}"
                    BorderBrush="{StaticResource BorderBrushSubtle}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14,12"
                    Margin="3.5,0,3.5,7">
                <StackPanel>
                    <TextBlock Text="AVG / 1% LOW"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="11" FontWeight="SemiBold" />
                    <TextBlock x:Name="AvgOnePercentText"
                               Text="— / —"
                               FontSize="24" FontWeight="Bold" FontFamily="Consolas"
                               Foreground="{StaticResource TextPrimary}"
                               Margin="0,6,0,4" />
                    <TextBlock x:Name="MinMaxText"
                               Text="Min: —  |  Max: —"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="12" />
                </StackPanel>
            </Border>

            <!-- CPU -->
            <Border Background="{StaticResource BgCard}"
                    BorderBrush="{StaticResource BorderBrushSubtle}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14,12"
                    Margin="7,0,0,7">
                <StackPanel>
                    <TextBlock Text="ПРОЦЕССОР (CPU)"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="11" FontWeight="SemiBold" />
                    <TextBlock x:Name="CpuValueText"
                               Text="—"
                               FontSize="26" FontWeight="Bold" FontFamily="Consolas"
                               Foreground="{StaticResource AccentBlue}"
                               Margin="0,4,0,2" />
                    <TextBlock x:Name="CpuTempSubText"
                               Text="Температура: —"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="12" />
                </StackPanel>
            </Border>

            <!-- GPU -->
            <Border Background="{StaticResource BgCard}"
                    BorderBrush="{StaticResource BorderBrushSubtle}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14,12"
                    Margin="0,7,7,0">
                <StackPanel>
                    <TextBlock Text="ВИДЕОКАРТА (GPU)"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="11" FontWeight="SemiBold" />
                    <TextBlock x:Name="GpuValueText"
                               Text="—"
                               FontSize="26" FontWeight="Bold" FontFamily="Consolas"
                               Foreground="{StaticResource AccentPurple}"
                               Margin="0,4,0,2" />
                    <TextBlock x:Name="GpuTempSubText"
                               Text="Температура: —"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="12" />
                </StackPanel>
            </Border>

            <!-- VRAM -->
            <Border Background="{StaticResource BgCard}"
                    BorderBrush="{StaticResource BorderBrushSubtle}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14,12"
                    Margin="3.5,7,3.5,0">
                <StackPanel>
                    <TextBlock Text="ВИДЕОПАМЯТЬ (VRAM)"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="11" FontWeight="SemiBold" />
                    <TextBlock x:Name="VramValueText"
                               Text="—"
                               FontSize="22" FontWeight="Bold" FontFamily="Consolas"
                               Foreground="{StaticResource TextPrimary}"
                               Margin="0,7,0,4" />
                    <TextBlock x:Name="VramSubText"
                               Text="Использовано / Всего"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="12" />
                </StackPanel>
            </Border>

            <!-- RAM -->
            <Border Background="{StaticResource BgCard}"
                    BorderBrush="{StaticResource BorderBrushSubtle}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14,12"
                    Margin="7,7,0,0">
                <StackPanel>
                    <TextBlock Text="ПАМЯТЬ (RAM)"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="11" FontWeight="SemiBold" />
                    <TextBlock x:Name="RamValueText"
                               Text="—"
                               FontSize="26" FontWeight="Bold" FontFamily="Consolas"
                               Foreground="{StaticResource AccentAmber}"
                               Margin="0,4,0,2" />
                    <TextBlock x:Name="RamSubText"
                               Text="Объём: —"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="12" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- График ScottPlot -->
        <Border Grid.Row="2"
                Background="{StaticResource BgSecondary}"
                BorderBrush="{StaticResource BorderBrushSubtle}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Margin="4,0,4,8">
                    <TextBlock Text="Телеметрия в реальном времени"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <RadioButton x:Name="ChartFpsRadio"
                                     Content="FPS"
                                     IsChecked="True"
                                     Foreground="{StaticResource TextPrimary}"
                                     Margin="0,0,14,0"
                                     Checked="ChartMode_Changed" />
                        <RadioButton x:Name="ChartFrametimeRadio"
                                     Content="Frametime (мс)"
                                     Foreground="{StaticResource TextPrimary}"
                                     Margin="0,0,14,0"
                                     Checked="ChartMode_Changed" />
                        <RadioButton x:Name="ChartLoadRadio"
                                     Content="CPU &amp; GPU (%)"
                                     Foreground="{StaticResource TextPrimary}"
                                     Checked="ChartMode_Changed" />
                    </StackPanel>
                </DockPanel>

                <ScottPlot:WpfPlot x:Name="TelemetryPlot" Grid.Row="1" />
            </Grid>
        </Border>

        <!-- Настройки оверлея -->
        <Border Grid.Row="3"
                Background="{StaticResource BgSecondary}"
                BorderBrush="{StaticResource BorderBrushSubtle}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12,9"
                Margin="0,12,0,0">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="Оверлей:"
                           Foreground="{StaticResource TextSecondary}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" />

                <TextBlock Text="Угол:"
                           Foreground="{StaticResource TextSecondary}"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0" />
                <ComboBox x:Name="CornerCombo"
                          Width="145"
                          Margin="0,0,16,0"
                          SelectionChanged="OverlaySetting_Changed">
                    <ComboBoxItem Content="Верхний левый" Tag="TopLeft" />
                    <ComboBoxItem Content="Верхний правый" Tag="TopRight" />
                    <ComboBoxItem Content="Нижний левый" Tag="BottomLeft" />
                    <ComboBoxItem Content="Нижний правый" Tag="BottomRight" />
                </ComboBox>

                <TextBlock Text="Прозрачность:"
                           Foreground="{StaticResource TextSecondary}"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0" />
                <Slider x:Name="OpacitySlider"
                        Minimum="0.35" Maximum="1.0" Value="0.88"
                        Width="95"
                        VerticalAlignment="Center"
                        Margin="0,0,16,0"
                        ValueChanged="OverlaySetting_Changed" />

                <CheckBox x:Name="CompactCheckBox"
                          Content="Компактно (в строку)"
                          Style="{StaticResource ModernCheckBox}"
                          VerticalAlignment="Center"
                          Margin="0,0,14,0"
                          Checked="OverlaySetting_Changed"
                          Unchecked="OverlaySetting_Changed" />

                <CheckBox x:Name="ShowOnePercentCheckBox"
                          Content="1% Low"
                          Style="{StaticResource ModernCheckBox}"
                          VerticalAlignment="Center"
                          Margin="0,0,14,0"
                          Checked="OverlaySetting_Changed"
                          Unchecked="OverlaySetting_Changed" />

                <CheckBox x:Name="ShowVramCheckBox"
                          Content="VRAM"
                          Style="{StaticResource ModernCheckBox}"
                          VerticalAlignment="Center"
                          Checked="OverlaySetting_Changed"
                          Unchecked="OverlaySetting_Changed" />
            </WrapPanel>
        </Border>

        <!-- Строка состояния -->
        <StatusBar Grid.Row="4"
                   Background="Transparent"
                   Foreground="{StaticResource TextSecondary}"
                   Margin="2,8,2,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Готов к запуску." FontSize="12" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
