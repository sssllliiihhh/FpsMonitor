<Window x:Class="FpsMonitor.Views.GameSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор процесса игры"
        Height="500" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource BgPrimary}"
        Foreground="{StaticResource TextPrimary}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Выберите запущенную игру для отслеживания FPS"
                   FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchBox"
                     Style="{StaticResource ModernTextBox}"
                     ToolTip="Фильтр по названию или .exe"
                     TextChanged="SearchBox_TextChanged" />

            <CheckBox x:Name="ShowAllCheckBox"
                      Grid.Column="1"
                      Content="Все процессы"
                      Style="{StaticResource ModernCheckBox}"
                      VerticalAlignment="Center"
                      Margin="12,0,0,0"
                      Checked="ShowAllCheckBox_Changed"
                      Unchecked="ShowAllCheckBox_Changed" />
        </Grid>

        <ListBox x:Name="ProcessList"
                 Grid.Row="2"
                 Background="{StaticResource BgSecondary}"
                 Foreground="{StaticResource TextPrimary}"
                 BorderBrush="{StaticResource BorderBrushSubtle}"
                 BorderThickness="1"
                 FontSize="13"
                 Padding="4"
                 MouseDoubleClick="ProcessList_MouseDoubleClick"
                 DisplayMemberPath="Label" />

        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <Button Content="Обновить"
                    Style="{StaticResource ModernButton}"
                    Click="RefreshButton_Click"
                    DockPanel.Dock="Left" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена"
                        Style="{StaticResource ModernButton}"
                        Click="CancelButton_Click"
                        Margin="0,0,8,0"
                        IsCancel="True" />
                <Button Content="Выбрать"
                        Style="{StaticResource PrimaryButton}"
                        Click="SelectButton_Click"
                        IsDefault="True" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
